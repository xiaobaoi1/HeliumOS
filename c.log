ar rcs build/libc.a build/libc_string.o build/libc_printf.o build/libc_malloc.o build/libc_signal.o build/libc_env.o build/libc_assert.o build/libc_ctype.o build/libc_qsort.o build/libc_abort.o build/libc_stdlib.o build/libc_inet.o build/libc_netdb.o build/libc_atexit.o build/libc_dl.o build/libc_stdio.o build/libc_errno.o build/libc_sem.o build/libc_inflate.o build/libc_iconv.o build/libc_pread.o build/libc_math.o build/libc_dirent.o build/libc_stat.o build/libc_zlib.o build/libc_unistd.o build/libc_time.o build/libc_locale.o build/libc_utsname.o build/libc_select.o build/libc_regex.o build/libc_execinfo.o build/libc_scandir.o build/libc_fd.o build/libc_mman.o build/libc_getcwd.o build/libc_termios.o build/libc_ioctl.o build/libc_sigreturn.o build/libc_setjmp.o
# 拷贝头文件
cp -r user/libc/include/* build/tcc_sysroot/include/
# 拷贝 crt0.o 和 libc.a
cp build/crt0.o build/tcc_sysroot/lib/
cp build/libc.a build/tcc_sysroot/lib/
cp user/libtcc1.a build/tcc_sysroot/lib/
gcc -m32 -static -nostdlib     -Wl,-T,user/linker.ld     -Wl,--start-group     user/tcc.out     user/libtcc.a     build/crt0.o     build/libc.a     -Wl,--end-group     /usr/lib/gcc/x86_64-linux-gnu/15/32/libgcc.a     -o build/TCC.ELF
正在创建 FAT32 硬盘镜像 (需要 sudo 权限)...
sudo umount /mnt/build 2>/dev/null || true
sudo losetup -d /dev/loop22 2>/dev/null || true
sudo losetup -d /dev/loop23 2>/dev/null || true
dd if=/dev/zero of=build/HeliumOS.img bs=1M count=64 status=none
(echo o; echo n; echo p; echo 1; echo 2048; echo; echo t; echo c; echo a; echo 1; echo w) | fdisk build/HeliumOS.img > /dev/null 2>&1
loop 分配: disk=/dev/loop21 part=/dev/loop22
